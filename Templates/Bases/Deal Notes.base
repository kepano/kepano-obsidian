filters:
  and:
    - categories.contains(link("Deal Notes"))
    - '!file.name.contains("Template")'
properties:
  file.name:
    displayName: Note
  note.deal:
    displayName: Deal
  note.date:
    displayName: Date
  note.people:
    displayName: People
  note.type:
    displayName: Type
views:
  - type: table
    name: Deal Notes
    order:
      - file.name
      - deal
      - date
      - type
      - people
    sort:
      - property: date
        direction: DESC
    columnSize:
      file.name: 220
      note.deal: 180
      note.date: 112
      note.type: 120
  - type: table
    name: Deal
    filters:
      and:
        - list(deal).contains(this)
    order:
      - file.name
      - date
      - type
      - people
    sort:
      - property: date
        direction: DESC
    columnSize:
      file.name: 220
      note.date: 112
      note.type: 120
  - type: table
    name: Person
    filters:
      and:
        - list(people).contains(this)
    order:
      - file.name
      - deal
      - date
      - type
    sort:
      - property: date
        direction: DESC
    columnSize:
      file.name: 220
      note.deal: 180
      note.date: 112
  - type: table
    name: Type
    filters:
      and:
        - list(type).contains(this)
    order:
      - file.name
      - deal
      - date
      - people
    sort:
      - property: date
        direction: DESC
    columnSize:
      file.name: 220
      note.deal: 180
      note.date: 112
